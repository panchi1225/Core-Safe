{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": { "host": "127.0.0.1", "port": 15001 },
    "firestore": {
      "host": "127.0.0.1",
      "port": 18080
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 19099
    },
    "ui": {
