{
  "name": "core-safe",
  "homepage": "https://panchi1225.github.io/Core-Safe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test src/utils/*.test.mjs tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-core-safe \"node --test tests/rules/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "fabric": "^7.2.0",
    "fflate": "^0.8.3",
    "firebase": "^12.9.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-to-print": "^3.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/react-signature-canvas": "^1.0.7",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.31.0",
    "gh-pages": "^6.3.0",
    "react-test-renderer": "^19.2.4",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
