{
  "name": "core-safe-public-autofill-staging",
  "main": "dist-staging/worker.mjs",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "MODE": "staging", "STAGING_ONLY": "synthetic-v1",
    "FIREBASE_PROJECT_ID": "demo-core-safe",
    "WORKER_NAME": "core-safe-public-autofill-staging",
    "ADMIN_UIDS": "staging-admin", "ALLOWED_ORIGINS": "http://127.0.0.1:5178",
    "PUBLIC_ENABLED": "true", "SYNC_APPROVED": "true"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "core-safe-autofill-staging", "database_id": "REPLACE_STAGING_ONLY" }]
}
